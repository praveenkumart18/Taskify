# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server port (defaults to 3000)
PORT=3000

# NODE_ENV: 'development' | 'production'
NODE_ENV=development

# MONGO_URI: MongoDB connection string
# Example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/taskify?retryWrites=true&w=majority
MONGO_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/taskify?retryWrites=true&w=majority"

# JWT_SECRET: Secret key for signing JSON Web Tokens
JWT_SECRET="your-super-secure-jwt-secret-at-least-32-chars-long"

# JWT_EXPIRE: Token expiration window (e.g. 7d, 24h)
JWT_EXPIRE="7d"

# CLIENT_URL: URL of frontend client for CORS credentials origin
CLIENT_URL="http://localhost:3000"
